
from fastapi import FastAPI, Form
from fastapi.responses import HTMLResponse
import uvicorn
import requests
from requests.auth import HTTPBasicAuth

# ---------------- Jira Configuration ----------------
JIRA_URL = "https://YOUR-JIRA-SERVER"
USERNAME = "YOUR_USERNAME"
PASSWORD = "YOUR_PASSWORD"

app = FastAPI(title="Jira Comment/Description Filter")


HTML = """
<!DOCTYPE html>
<html>
<head>
    <title>Jira Comment/Description Search</title>
    <style>
    body{font-family:Arial;margin:40px}
    textarea{width:100%;height:120px}
    table{border-collapse:collapse;width:100%;margin-top:20px}
    td,th{border:1px solid #ccc;padding:8px}
    button{padding:10px 20px}
    </style>
</head>
<body>
    <h2>Jira Search</h2>
    <form method="post">
        <textarea name="jql" placeholder="Enter JQL"></textarea><br><br>
        <label><input type="checkbox" name="description" checked> Description Changed</label>
        <label><input type="checkbox" name="comment" checked> Comment Changed</label>
        <br><br>
        <button type="submit">Search</button>
    </form>
    {results}
</body>
</html>
"""


def search_issues(jql):
    url = f"{JIRA_URL}/rest/api/2/search"
    start = 0
    issues = []

    while True:
        payload = {
            "jql": jql,
            "startAt": start,
            "maxResults": 100,
            "fields": ["summary"]
        }

        r = requests.post(
            url,
            json=payload,
            auth=HTTPBasicAuth(USERNAME, PASSWORD),
            headers={"Content-Type": "application/json"},
            timeout=60
        )
        r.raise_for_status()

        data = r.json()
        issues.extend(data["issues"])

        start += data["maxResults"]
        if start >= data["total"]:
            break

    return issues


def issue_matches(issue_key, check_desc, check_comment):
    url = f"{JIRA_URL}/rest/api/2/issue/{issue_key}?expand=changelog"

    r = requests.get(
        url,
        auth=HTTPBasicAuth(USERNAME, PASSWORD),
        timeout=60
    )
    r.raise_for_status()

    data = r.json()

    matches = []

    for history in data["changelog"]["histories"]:
        author = history["author"]["displayName"]
        created = history["created"]

        for item in history["items"]:
            field = item["field"].lower()

            if check_desc and field == "description":
                matches.append(("Description", author, created))

            if check_comment and field == "comment":
                matches.append(("Comment", author, created))

    return matches


@app.get("/", response_class=HTMLResponse)
def home():
    return HTML.format(results="")


@app.post("/", response_class=HTMLResponse)
def run_search(
    jql: str = Form(...),
    description: str | None = Form(None),
    comment: str | None = Form(None)
):
    rows = ""

    try:
        issues = search_issues(jql)

        for issue in issues:
            changes = issue_matches(
                issue["key"],
                description is not None,
                comment is not None
            )

            for field, user, dt in changes:
                rows += f"<tr><td>{issue['key']}</td><td>{issue['fields']['summary']}</td><td>{field}</td><td>{user}</td><td>{dt}</td></tr>"

        if rows:
            results = f"""
            <table>
            <tr>
            <th>Issue</th>
            <th>Summary</th>
            <th>Changed Field</th>
            <th>Changed By</th>
            <th>Date</th>
            </tr>
            {rows}
            </table>
            """
        else:
            results = "<h3>No matching issues found.</h3>"

    except Exception as e:
        results = f"<pre>{e}</pre>"

    return HTML.format(results=results)


if __name__ == "__main__":
    import webbrowser
    webbrowser.open("http://127.0.0.1:8000")
    uvicorn.run(app, host="127.0.0.1", port=8000)
